# Import only inside the existing https://llm.lazying.art site.
# Public static legal pages: no account, JavaScript, app process or GitHub required.
@bunko_legal {
    method GET HEAD
    path /bunko/privacy.html /bunko/terms.html
}
handle @bunko_legal {
    root * /opt/bunko-legal/current
    uri strip_prefix /bunko
    header Cache-Control "public, max-age=300"
    header X-Content-Type-Options nosniff
    header Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; base-uri 'none'; frame-ancestors 'none'"
    file_server
}
@bunko_books {
    method GET HEAD
    path /bunko/books-cache/*
}
handle @bunko_books {
    encode zstd gzip
    reverse_proxy 127.0.0.1:18624 {
        header_up Host llm.lazying.art
        header_up -Cookie
        header_up -Authorization
        header_up -Forwarded
        header_up -X-Forwarded-For
        header_up X-Bunko-Client-Address {remote_host}
    }
}
@bunko_discussions {
    method POST OPTIONS
    path /bunko/v1/auth/start /bunko/v1/auth/demo /bunko/v1/auth/complete /bunko/v1/session /bunko/v1/logout /bunko/v1/discussions/read /bunko/v1/discussions/post
}
@bunko_callback {
    method GET
    path /bunko/oauth/callback /bunko/healthz
}
handle @bunko_discussions {
    request_body {
        max_size 18KB
    }
    reverse_proxy 127.0.0.1:18624 {
        header_up Host llm.lazying.art
        header_up -Forwarded
        header_up -X-Forwarded-For
        header_up X-Bunko-Client-Address {remote_host}
    }
}
handle @bunko_callback {
    reverse_proxy 127.0.0.1:18624 {
        header_up Host llm.lazying.art
        header_up -Forwarded
        header_up -X-Forwarded-For
        header_up X-Bunko-Client-Address {remote_host}
    }
}

# Private document companion. Every operation additionally requires an app session.
@bunko_agent {
    method POST OPTIONS
    path /bunko/v1/agent/state /bunko/v1/agent/document /bunko/v1/agent/upload /bunko/v1/agent/import /bunko/v1/agent/delete /bunko/v1/agent/resume /bunko/v1/agent/messages /bunko/v1/agent/send /bunko/v1/agent/report /bunko/v1/agent/clear
}
handle @bunko_agent {
    request_body {
        max_size 27MB
    }
    reverse_proxy 127.0.0.1:18624 {
        header_up Host llm.lazying.art
        header_up -Forwarded
        header_up -X-Forwarded-For
        header_up X-Bunko-Client-Address {remote_host}
    }
}

# Optional cloud plans. Purchases require an app session; provider notifications
# have independently verified signatures/identities and never accept app tokens.
@bunko_cloud {
    method POST OPTIONS
    path /bunko/v1/cloud/catalog /bunko/v1/cloud/purchase /bunko/v1/cloud/checkout /bunko/v1/cloud/portal /bunko/v1/cloud/restore /bunko/v1/cloud/notifications/apple /bunko/v1/cloud/notifications/google /bunko/v1/cloud/notifications/stripe
}
handle @bunko_cloud {
    request_body {
        max_size 200KB
    }
    reverse_proxy 127.0.0.1:18624 {
        header_up Host llm.lazying.art
        header_up -Forwarded
        header_up -X-Forwarded-For
        header_up X-Bunko-Client-Address {remote_host}
    }
}
